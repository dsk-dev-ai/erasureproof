# ErasureProof configuration (copy to .env for local development)

# Application
ERASUREPROOF_ENVIRONMENT=development
ERASUREPROOF_APP_NAME=ErasureProof

# Storage
# SQLite works out of the box. For Postgres use:
# ERASUREPROOF_DATABASE_URL=postgresql+psycopg://erasureproof:erasureproof@localhost:5432/erasureproof
ERASUREPROOF_DATABASE_URL=sqlite:///./.erasureproof/erasureproof.db
ERASUREPROOF_DATA_DIR=./.erasureproof

# Signing key for attestations. Replace in any non-local environment.
ERASUREPROOF_ATTESTATION_KEY=dev-insecure-change-me

# Policies
ERASUREPROOF_POLICY_DIR=./policies
ERASUREPROOF_DEFAULT_JURISDICTION=gdpr

# Optional: Temporal (leave unset to use the in-process orchestrator)
# ERASUREPROOF_TEMPORAL_ADDRESS=localhost:7233
