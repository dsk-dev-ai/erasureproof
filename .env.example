# ErasureProof configuration (copy to .env for local development)

# Application
ERASUREPROOF_ENVIRONMENT=development
ERASUREPROOF_APP_NAME=ErasureProof

# Storage
# SQLite works out of the box. For Postgres use:
# ERASUREPROOF_DATABASE_URL=postgresql+psycopg://erasureproof:erasureproof@localhost:5432/erasureproof
ERASUREPROOF_DATABASE_URL=sqlite:///./.erasureproof/erasureproof.db
ERASUREPROOF_DATA_DIR=./.erasureproof
# Static console build served at /console
ERASUREPROOF_WEB_DIR=./web/dist

# Signing key for attestations and backup manifests. Replace in any non-local
# environment; production startup rejects this default.
# Generate with: openssl rand -hex 32
ERASUREPROOF_ATTESTATION_KEY=dev-insecure-change-me

# Policies
ERASUREPROOF_POLICY_DIR=./policies
ERASUREPROOF_DEFAULT_JURISDICTION=gdpr

# The console demo bootstrap is safe and non-destructive; disable it in production.
ERASUREPROOF_DEMO_ENABLED=true

# Public sandbox onboarding. Enabled on the hosted demo; keep disabled for private
# production deployments unless you want anonymous sandbox provisioning.
ERASUREPROOF_SELF_SERVE_ENABLED=false
ERASUREPROOF_SANDBOX_TTL_HOURS=168
ERASUREPROOF_SANDBOX_DAILY_LIMIT=100
ERASUREPROOF_SANDBOX_PER_IP_DAILY_LIMIT=3
ERASUREPROOF_API_KEY_MAX_PER_TENANT=25

# Access control. ``disabled`` is for local development only. Production refuses
# to start with authentication disabled.
ERASUREPROOF_AUTH_MODE=disabled
# Static API keys as a JSON list. One key per operator; scope tenant_id to "*"
# only for a break-glass deployment administrator.
# ERASUREPROOF_API_KEYS=[{"key":"replace-with-random-key","role":"admin","tenant_id":"*","subject":"admin"}]
# OIDC alternative (install the oidc extra):
# ERASUREPROOF_OIDC_ISSUER=https://idp.example.com
# ERASUREPROOF_OIDC_AUDIENCE=erasureproof
# ERASUREPROOF_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# ERASUREPROOF_OIDC_ALGORITHMS=RS256
# ERASUREPROOF_OIDC_ROLE_CLAIM=roles
# ERASUREPROOF_OIDC_TENANT_CLAIM=tenant_id

# Require a second administrator to approve destructive remediation.
ERASUREPROOF_REQUIRE_REMEDIATION_APPROVAL=false
ERASUREPROOF_APPROVAL_REQUIRES_SEPARATE_USER=true
ERASUREPROOF_APPROVAL_TTL_HOURS=24

# Edge controls and observability.
ERASUREPROOF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ERASUREPROOF_RATE_LIMIT_PER_MINUTE=0
ERASUREPROOF_TRUST_PROXY_HEADERS=false
ERASUREPROOF_HSTS_SECONDS=0
ERASUREPROOF_METRICS_ENABLED=true
# ERASUREPROOF_METRICS_TOKEN=

# Optional: Temporal (leave unset to use the in-process orchestrator)
# ERASUREPROOF_TEMPORAL_ADDRESS=localhost:7233

# Passive exposure discovery is opt-in and requires --authorized per scan.
ERASUREPROOF_EXPOSURE_ENABLED=false
# ERASUREPROOF_EXPOSURE_RATE_LIMIT_SECONDS=1.0
# ERASUREPROOF_EXPOSURE_MAX_BYTES=2000000
# ERASUREPROOF_SERPER_API_KEY=
# ERASUREPROOF_BRAVE_API_KEY=
# ERASUREPROOF_GITHUB_TOKEN=
# ERASUREPROOF_HIBP_API_KEY=
