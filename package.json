{
  "name": "erasureproof",
  "version": "1.1.0",
  "private": true,
  "description": "ErasureProof API and operations console",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:web": "node scripts/dev.mjs --web-only",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "test": ".venv/bin/pytest -q"
  },
  "engines": {
    "node": ">=20"
  }
}
